# Path: templates/base/pyproject.toml.j2
[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Enterprise Omni-channel AI Agent"
requires-python = ">={{ python_version }}"
dependencies = [
    # Core API and Web Layer
    "fastapi[standard]>=0.115.0",
    "uvicorn>=0.30.0",
    
    # AI & Agentic Frameworks
    "langchain>=0.3.0",
    "langgraph>=0.2.0",
    "langchain-groq>=0.2.0",
    
    # Utilities
    "pydantic-settings>=2.7.0",
    "rich>=13.7.0",
{% if has_mcp %}
    # Model Context Protocol
    "fastmcp>=0.1.0",
    "mcp>=0.1.0",
{% endif %}
{% if has_db %}
    # Database ORM and Migrations
    "sqlalchemy[asyncio]>=2.0.0",
    "asyncpg>=0.29.0",
    "alembic>=1.13.0",
{% endif %}
{% if has_observability %}
    # AI Observability and Telemetry
    "opik>=0.1.0",
{% endif %}
]

[tool.ruff]
target-version = "py312"
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "W", "I"]