# Path: templates/base/.env.example.j2
# ==============================================================================
# {{ project_name }} - local environment configuration template
# Copy this file to '.env' and populate with your secure API keys.
# ==============================================================================

# Core Application Settings
ENVIRONMENT="development"
ENABLE_DEBUG_LOGS=false
APP_NAME="{{ project_name }}"

# LLM Providers Configuration
GROQ_API_KEY="replace-me-locally"
GEMINI_API_KEY="replace-me-locally"

{% if has_db %}
# Database Connection String (SQLAlchemy Compatible)
DATABASE_URL="postgresql+asyncpg://app:replace-me-locally@localhost:5432/app"
{% endif %}

{% if has_observability %}
# AI Observability Configuration (Opik)
OPIK_API_KEY="replace-me-locally"
OPIK_WORKSPACE="replace-me-locally"
OPIK_PROJECT_NAME="{{ project_name }}"
{% endif %}
