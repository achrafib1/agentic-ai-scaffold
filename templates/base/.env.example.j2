# Path: templates/base/.env.example.j2
# ==============================================================================
# {{ project_name }} - Enterprise Environment Configuration Template
# Copy this file to '.env' and populate with your secure API keys.
# ==============================================================================

# Core Application Settings
ENVIRONMENT="development"
DEBUG_MODE=true
APP_NAME="{{ project_name }}"

# LLM Providers Configuration
GROQ_API_KEY="your-groq-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

{% if has_db %}
# Database Connection String (SQLAlchemy Compatible)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
{% endif %}

{% if has_observability %}
# AI Observability Configuration (Opik)
OPIK_API_KEY="your-opik-api-key-here"
OPIK_WORKSPACE="your-workspace-name"
OPIK_PROJECT_NAME="{{ project_name }}"
{% endif %}