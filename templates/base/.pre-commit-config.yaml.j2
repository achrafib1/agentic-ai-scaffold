# Path: templates/base/.pre-commit-config.yaml.j2
# ==============================================================================
# {{ project_name }} - Pre-Commit Hooks Configuration
# Enforces industry-standard code formatting (Ruff) before allowing Git commits.
# ==============================================================================

repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.3.4
    hooks:
      - id: ruff
        args: [--fix, --exit-non-zero-on-fix]
      - id: ruff-format