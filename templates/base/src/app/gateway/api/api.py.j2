"""
Top-level API router configuration.

This module aggregates all versioned API routers for the {{ project_name }} Gateway.
Currently, it mounts the v1 router. This modular design cleanly isolates major 
API revisions, allowing v1 and v2 to run concurrently in production without friction.
"""

import logging
from fastapi import APIRouter
from rich.console import Console

from app.gateway.api.v1.api import api_v1_router

logger = logging.getLogger(__name__)
console = Console()

# Instantiate the master API router that will be mounted in main.py
api_router = APIRouter()

# Include the v1 router under the "/v1" path prefix.
logger.debug("Mounting v1 API router under /v1 prefix.")
api_router.include_router(api_v1_router, prefix="/v1")