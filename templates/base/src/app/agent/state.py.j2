"""
Agent State definition module.

Defines the state schema for the LangGraph state machine.
Inherits from `MessagesState` to automatically handle message appending and history,
while adding custom fields necessary for the Omni-Agent's context (e.g., routing flags).
"""

import logging
from typing import TypedDict, Annotated
from langgraph.graph.message import add_messages
from langchain_core.messages import BaseMessage

logger = logging.getLogger(__name__)

class AgentState(TypedDict):
    """
    The state schema for the Omni-Agent graph.
    
    Attributes:
        messages (list[BaseMessage]): The conversation history. The `add_messages` 
                                      reducer ensures new messages are appended rather than overwritten.
        requires_tools (bool): A flag indicating if the LLM has requested tool execution.
        summary (str): A rolling summary of the conversation to manage token limits.
    """
    messages: Annotated[list[BaseMessage], add_messages]
    requires_tools: bool
    summary: str